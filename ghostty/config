# =========================
# Font
# =========================
font-family = Fira Code Nerd Font
font-size = 13

# 리가처 활성화 (Fira Code 핵심)
font-feature = liga
font-feature = calt

# =========================
# Window / Padding
# =========================
window-padding-x = 8
window-padding-y = 8
window-decoration = auto
window-save-state = always

# =========================
# Cursor
# =========================
cursor-style = block
# 깜빡임 비활성화 → 렌더 재그리기 감소 + 시각 피로 완화
cursor-style-blink = false

# =========================
# Scrolling
# =========================
scrollback-limit = 10000

# =========================
# Mouse / Selection
# =========================
mouse-hide-while-typing = true
copy-on-select = false

# =========================
# Performance
# =========================
# 리가처(liga/calt) 연산이 대형 화면에서 부담될 경우, 위 Font 섹션의
# font-feature 두 줄을 주석 처리하면 글리프 셰이핑 비용이 줄어듭니다.

# 커서가 있는 창만 완전 불투명, 나머지는 살짝 흐리게 → 무의미한 재그리기 억제 없음, 순수 시각 구분
unfocused-split-opacity = 0.9

# macOS non-native 전체화면 전환을 부드럽게(화면 튐 방지)
macos-non-native-fullscreen = visible-menu

# =========================
# Keybindings (선택)
# =========================
# Cmd + Enter → 전체화면
keybind = cmd+shift+f=toggle_fullscreen

# Cmd + K → 화면 정리 (clear: 스크롤백 포함)
keybind = cmd+k=clear_screen

# =========================
# Shell
# =========================
# 기본 쉘을 명시하고 싶다면 (예: bash, zsh)
# shell = /bin/zsh
